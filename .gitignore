# ==========================================
# .NET / C# Exclusions
# ==========================================
**/bin/
**/obj/
**/.vs/
**/*.user
**/*.userosscache
**/*.sln.docstates
**/appsettings.Development.json
**/appsettings.Local.json

# ==========================================
# Angular / Node.js Exclusions
# ==========================================
**/node_modules/
**/.angular/
**/dist/
**/tmp/
**/.sass-cache/
**/connect.lock
**/coverage/
*.log

# ==========================================
# Environment & IDE Exclusions
# ==========================================
.DS_Store
Thumbs.db
*.swp
*.bak
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json