                  "password": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "createdDate": {
                    "type": "string",
                    "format": "style"
                  }
                }
              },
              "example": {
                "userId": 3,
                "emailId": "samuel.njogu@example.com",
                "fullName": "Samuel Njogu",
                "mobileNo": "+254733112233",
